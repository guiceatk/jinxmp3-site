# ─────────────────────────────────────────────────────────────────────────────
# JINXMP3 MASTER AUTOMATION — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Local paths ───────────────────────────────────────────────────────────────
JINX_SITE_DIR=C:\Users\Jinx\projects\jinxmp3-site
JINX_MUSIC_DIR=C:\Users\Jinx\Music\Suno_DistroKid_Releases

# ── Origin server ─────────────────────────────────────────────────────────────
JINX_ORIGIN_URL=http://127.0.0.1:8080

# ── Cloudflare ────────────────────────────────────────────────────────────────
JINX_TUNNEL_NAME=jinxmp3
JINX_TUNNEL_HOSTNAME=www.jinxmp3.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here

# ── Shopify ───────────────────────────────────────────────────────────────────
# Get from: Shopify Admin → Apps → Develop apps → Create app → Admin API
SHOPIFY_STORE_DOMAIN=jinxmp3.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_KEY=your_storefront_api_key_here

# ── GitHub ────────────────────────────────────────────────────────────────────
JINX_GIT_REMOTE=origin
JINX_GIT_BRANCH=master

# ── AI / LLM ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Agent loop ────────────────────────────────────────────────────────────────
AGENT_POLL_SECONDS=300
